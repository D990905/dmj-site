<!-- Brand Story · Video (Phase 10) -->
<!-- Click-to-play poster (2026-05): error 153 fallback. iframe은 user click시 main.js가 inject. -->
<section class="section section--mist" id="brand-video">
  <div class="container container--narrow">
    <div class="section-head section-head--center reveal">
      <span class="section-head__eyebrow">Brand Story · Video</span>
      <h2 class="section-head__title">Forward WIP을 영상으로</h2>
      <p class="section-head__lead">'눈에 안 띄지만 없으면 안 되는 brand' — 안전이 곧 progression이라는 단무지 철학과 정확히 맞물립니다</p>
    </div>
    <div class="brand-video-wrap reveal">
      <a class="video-link-card" href="https://www.youtube.com/watch?v=jYYALh_9ozQ" target="_blank" rel="noopener noreferrer" aria-label="Forward WIP Your Guardian Angel 영상 — YouTube에서 새 탭 열기" style="display:block;position:relative;border-radius:16px;overflow:hidden;background:#000;text-decoration:none">
        <img class="video-link-card__thumb" loading="lazy"
             src="https://i.ytimg.com/vi/jYYALh_9ozQ/maxresdefault.jpg"
             onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/jYYALh_9ozQ/hqdefault.jpg';"
             alt="Forward WIP YOUR GUARDIAN ANGEL 썸네일"
             style="width:100%;display:block;opacity:.92">
        <span class="video-link-card__overlay" aria-hidden="true" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,rgba(0,0,0,.05) 0%,rgba(0,0,0,.45) 100%)">
