  <!-- Worldwide 24-month Warranty USP (Race Series 한정 · race-grade 자신감) -->
  <section class="section section--tight" id="warranty-usp">
    <div class="container">
      <div style="max-width:880px;margin:0 auto;padding:28px 32px;background:linear-gradient(135deg,var(--color-navy) 0%,#1a3550 100%);border-radius:16px;color:#fff;display:flex;flex-direction:column;gap:14px;box-shadow:0 8px 24px rgba(10,37,64,0.15)">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <span style="background:var(--color-sun);color:var(--color-navy);font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;padding:6px 14px;border-radius:999px;text-transform:uppercase">Race-grade 자신감</span>
          <span style="font-size:0.8125rem;color:rgba(255,255,255,0.72);letter-spacing:0.04em;text-transform:uppercase">Worldwide Warranty · Race Series 한정</span>
        </div>
        <h2 style="margin:0;font-size:1.5rem;line-height:1.4;color:#fff">한국 포함 <span style="color:var(--color-sun)">worldwide 24개월</span> 본사 워런티</h2>
        <p style="margin:0;font-size:0.9375rem;color:rgba(255,255,255,0.86);line-height:1.7">
          Levitaz Free Series는 EU 외 6개월인데, R6 Race Series만 worldwide 24개월 — race-grade 라인에만 boundary가 사라집니다.
          본사가 race 라인 가혹 사용 패턴까지 포함해 24개월 무결함을 약속한다는 뜻으로,
          R6를 선택하시는 라이더에게는 worldwide 24개월이 가장 객관적인 신뢰 지표입니다
        </p>
        <p style="margin:0;font-size:0.8125rem;color:rgba(255,255,255,0.6);line-height:1.6">
          ※ 출처 — Levitaz HQ 직접 명시 (2026-05-10 confirmed) ·
          <a href="../../levitaz.html#warranty-policy" style="color:var(--color-sun);text-decoration:underline">정책 비교 표 보기 →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Skill journey -->
  <section class="section section--tight">
    <div class="container">
      <h2 class="section-head section-head--center">라이딩 여정에서 이 모델의 위치</h2>
      <p class="section-sub section-sub--center">현재 모델은 어느 단계의 라이더에게 적합한지, 다음 step은 무엇인지 표시합니다.</p>
      
    <ol class="journey">
      
        <li class="journey-step journey-step--passed" data-tier="beginner">
          <span class="journey-step__dot"></span>
          <span class="journey-step__label">입문자</span>
