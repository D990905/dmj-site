  <!-- Spec table -->
  <section class="section">
    <div class="container">
      <h2 class="section-head section-head--center">제원 (Specifications)</h2>
      <p class="section-sub section-sub--center">본사 공식 스펙 + 한국 가격. 정확한 견적은 카톡 1:1 상담으로 확인하세요.</p>
      
    <div class="spec-table-wrap">
      <table class="spec-table">
        <caption class="spec-table__caption">공통 사양</caption>
        <tbody>
          <tr><th scope="row">용도</th><td>Formula Kite race 전용</td></tr><tr><th scope="row">재질</th><td>Stainless-steel box + Titanium mast + Carbon front wing</td></tr><tr><th scope="row">구조</th><td>Integrated trim system (on-water 조절 가능)</td></tr><tr><th scope="row">검증</th><td>2024 Paris Olympic Formula Kite 사용</td></tr>
        </tbody>
      </table>
    </div>
    <div class="spec-table-wrap">
      <table class="spec-table spec-table--sized">
        <caption class="spec-table__caption">사이즈별 사양</caption>
        <thead>
          <tr><th scope="col">구성</th><th scope="col">권장 체중</th><th scope="col">권장 풍속</th><th scope="col">한국 가격</th></tr>
        </thead>
        <tbody>
