        <li class="journey-step journey-step--passed" data-tier="intermediate">
          <span class="journey-step__dot"></span>
          <span class="journey-step__label">초중급</span>
        </li>
        <li class="journey-step journey-step--passed" data-tier="advanced">
          <span class="journey-step__dot"></span>
          <span class="journey-step__label">상급자</span>
        </li>
        <li class="journey-step journey-step--active" data-tier="pro">
          <span class="journey-step__dot"></span>
          <span class="journey-step__label">선수레벨</span>
        </li>
    </ol>
    </div>
  </section>

