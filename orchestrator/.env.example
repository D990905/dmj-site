# Copy to ~/.config/orchestrator/.env (chmod 600).
# Secrets are preferred in macOS Keychain (see docs/SETUP.md). .env is fallback.
# .env is permanently gitignored.

# ====================================================================
# Mode: deploy-only (default) — only the auto-push loop runs.
#   No API keys required. Zero cost. Immediate value (PUSH-FIX replacement).
# Mode: full — also runs the directive polling loop and agent dispatch.
#   Set ENABLE_DIRECTIVE_LOOP=true and fill in the keys below.
# ====================================================================
ENABLE_DIRECTIVE_LOOP=false

# --- Required only when ENABLE_DIRECTIVE_LOOP=true ---
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=D990905/dmj-site

# --- Auto-deploy (always used) ---
# Comma-separated list of LOCAL working copies the daemon should auto-push.
# For 단무지공방 site:
AUTO_DEPLOY_REPOS=/Users/dannyok/Documents/Claude/Projects/단무지공방 홈페이지 만들기/site

# --- Optional tuning ---
POLL_INTERVAL_SECONDS=30
MONTHLY_BUDGET_USD=50
DAILY_NOTIFY_USD=10
DEFAULT_MAX_BUDGET_USD=1.50
DEFAULT_MAX_TURNS=30
WORKSPACE_DIR=/Users/dannyok/dev/orchestrator-workspace
LOG_DIR=/Users/dannyok/Library/Logs/Orchestrator
