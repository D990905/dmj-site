nt_wing":"lvz-r6-fw-v1","mast":"lvz-r6-mast-v1","stab":"lvz-r6-rear-wing-v1","set_id":"lvz-r6-set-v1","set_label":"Levitaz R6 풀세트 (Wingfoil race + Kite race cross-platform 호환)"},"board":"lvz-boom-fs83","accessories":["wip-impact-vest","wip-wetsuit-32","wip-harness","wip-helmet"],"reasoning":"선수 · 85kg 이상 · Hybrid (다목적·all-condition) 조합. Race wing은 PPC Sonic FDS (풀 듀얼스킨 race wing) — 유일 race wing (Takoon V4 Pro는 freeride race-tuned, 진짜 race 아님). size: 6.0m²·6.5m²·7.0m². 포일은 **Levitaz R6 풀세트** (R6 Front Wing + R6 Mast + R6 Rear Wing) — 선수 race-grade UHM 카본 hydrofoil. **Levitaz R6 = Wingfoil race + Kite race cross-platform 호환** (Olympic 검증 race grade, 0.1초가 의미를 갖는 환경). 보드는 lvz-boom-fs83. ADVANCED 단계는 Free Series FW 540/680/790 (체중·풍속별).","tags":["[Danny review] heavy pro 라이더는 본사에서도 custom 권장 — 1:1 컨설팅"],"review_status":"curated","danny_review_flag":false}]},
};
</script>
<!-- §171-B cart system — auth-shim + cart utility (loaded before matrix.js renderItem uses DMJCart). -->
<script src="assets/js/auth-shim.js"></script>
<script src="assets/js/cart.js"></script>
<script src="assets/js/matrix.js"></script>
<script src="assets/js/access-code.js"></script>
<script>
(function () {
  'use strict';
  if (window.DMJAccess) { window.DMJAccess.applyUnlock(); }

  const state = {
    demographic: null,
    level: null,
    weight: null,
    style: null,
    sport: null,
    step: 1
  };

  const STEPS = ['step-demographic', 'step-level', 'step-weight', 'step-style', 'step-sport', 'step-result'];
  const KEYS = ['demographic', 'level', 'weight', 'style', 'sport'];
  const TOTAL = 5;

  function showStep(idx) {
    STEPS.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el) el.style.display = (i === idx) ? '' : 'none';
    });
    state.step = idx + 1;
    const pct = idx >= TOTAL ? 100 : ((idx + 1) / TOTAL) * 100;
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('stepLabel').textContent = idx >= TOTAL ? '완료' : 'Step ' + (idx + 1) + ' / ' + TOTAL;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function selectOption(stepIdx, value) {
    state[KEYS[stepIdx]] = value;
    if (stepIdx + 1 < TOTAL) {
      setTimeout(() => showStep(stepIdx + 1), 280);
    } else {
      // submit
      setTimeout(() => renderResult(), 280);
    }
  }

  // §171 v2 (Danny 2026-05-13) — guard so we save fmg_history only once per quiz completion
  // (re-renders / DOM thrashing X). Reset on restart.
  state.savedThisSession = false;
  // §171-C — active entry id (set by saveFmgHistoryOnce or restoreFromEntry).
  state.activeFmgEntryId = null;

  // §171-C (Danny 2026-05-13) — fmg_history state-aware routing helper.
  // Exposed on window.DMJFmg so cart.js / quote.html can mutate the latest entry's state.
  // DO_NOT_REVERT §171-C — schema lock (state ∈ {recommendation_only, cart_added, quote_submitted}).
  function updateFmgState(entryId, newState, extra) {
    if (!window.DMJAuth || !window.DMJAuth.getUserData || !window.DMJAuth.setUserData) return false;
    try {
      var raw = window.DMJAuth.getUserData('fmg_history') || '[]';
      var history = JSON.parse(raw);
      if (!Array.isArray(history)) return false;
      var idx = -1;
      if (entryId) {
        for (var i = 0; i < history.length; i++) {
          if (history[i] && history[i].id === entryId) { idx = i; break; }
        }
      }
      // fallback to latest entry if entryId not found / null
      if (idx < 0) idx = history.length - 1;
      if (idx < 0) return false;
      history[idx].state = newState;
      if (extra && typeof extra === 'object') {
        Object.keys(extra).forEach(function (k) { history[idx][k] = extra[k]; });
      }
      window.DMJAuth.setUserData('fmg_history', JSON.stringify(history));
      console.info('[FMG] state →', newState, 'on', history[idx].id);
      return true;
    } catch (err) {
      console.warn('[FMG] updateFmgState failed', err);
      return false;
    }
  }

  // Expose helper for other pages (cart.js cart-add hook, quote.html submit hook).
  window.DMJFmg = window.DMJFmg || {};
  window.DMJFmg.updateFmgState = updateFmgState;
  window.DMJFmg._setActiveEntryId = function (id) { state.activeFmgEntryId = id; };
  window.DMJFmg._getActiveEntryId = function () { return state.activeFmgEntryId; };
  // Convenience accessor that reads from storage (used by cart.js / quote.html
  // when find-my-gear.html is not the host page — see DMJFmg.markLatestCartAdded etc.).
  window.DMJFmg.getLatestEntryId = function () {
    try {
      var raw = window.DMJAuth && window.DMJAuth.getUserData ? window.DMJAuth.getUserData('fmg_history') : null;
      var hist = raw ? JSON.parse(raw) : [];
      if (Array.isArray(hist) && hist.length) return hist[hist.length - 1].id;
    } catch (e) {}
    return null;
  };

  // §171-C — restore from saved fmg_history entry via URL `?restore=<entry-id>`.
  // 성공 시 퀴즈 step skip, 결과 페이지 직접 노출. invalid id → silent fallback to step 1.
  async function tryRestoreFromUrlParam() {
    var params;
    try { params = new URLSearchParams(window.location.search || ''); }
    catch (e) { return false; }
    var restoreId = params.get('restore');
    if (!restoreId) return false;

    if (!window.DMJAuth || !window.DMJAuth.getUserData) return false;
    var raw, history;
    try {
      raw = window.DMJAuth.getUserData('fmg_history') || '[]';
      history = JSON.parse(raw);
    } catch (e) { history = []; }
    if (!Array.isArray(history)) return false;

    var entry = history.find(function (h) { return h && h.id === restoreId; });
    if (!entry) {
      console.warn('[FMG] restore: entry not found', restoreId);
      return false;
    }
    if (!entry.level || !entry.weight || !entry.style) {
      console.warn('[FMG] restore: incomplete entry', restoreId);
      return false;
    }

    // Hydrate state so "다시 진단" path still works.
    state.level = entry.level;
    state.weight = entry.weight;
    state.style = entry.style;
    state.demographic = entry.demographic || null;
    state.sport = entry.sport || null;
    state.savedThisSession = true; // 복원 = 새 entry 저장 X (이미 존재)
    state.activeFmgEntryId = entry.id;

    showStep(TOTAL); // result step

    // Render an "이전 추천 — 다시 시작하려면 ↻ 클릭" hint banner above results.
    var container = document.getElementById('result-container');
    if (!container) return false;
    if (!window.DMJMatrix) {
      container.innerHTML = '<p style="color:#fff;text-align:center;padding:48px">매트릭스 로딩 실패. 잠시 후 다시 시도해 주세요.<br><br>문의: <a href="mailto:consulting@dmjgroup.kr" style="color:#FFB800;text-decoration:underline">consulting@dmjgroup.kr</a></p>';
      return true;
    }
    try {
      await window.DMJMatrix.renderQuiz(
        entry.level, entry.weight, entry.style,
        '#result-container',
        { demographic: entry.demographic, sport: entry.sport }
      );
      injectResultCTAs();
      // 복원 안내 banner — quiz-result 상단.
      var result = container.querySelector('.quiz-result');
      if (result && !result.querySelector('.fmg-restore-banner')) {
        var banner = document.createElement('div');
        banner.className = 'fmg-restore-banner';
        banner.style.cssText = 'background:rgba(31,143,255,0.12);border:1px solid rgba(31,143,255,0.35);border-radius:10px;padding:10px 14px;margin:0 0 16px;color:#fff;font-size:13px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap';
        var dateStr = entry.savedAt ? new Date(entry.savedAt).toLocaleDateString('ko-KR') : '';
        banner.innerHTML = '<span>📋 이전 추천 (' + dateStr + ') — 저장된 결과를 보고 있습니다.</span>'
          + '<a href="find-my-gear.html" style="color:var(--color-sun);font-weight:700;text-decoration:none">↻ 퀴즈 다시 시작</a>';
        result.insertBefore(banner, result.firstChild);
      }
      return true;
    } catch (err) {
      console.error('[FMG] restore render failed:', err);
      return false;
    }
  }

  async function renderResult() {
    showStep(TOTAL); // result step idx
    const container = document.getElementById('result-container');
    if (!window.DMJMatrix) {
      container.innerHTML = '<p style="color:#fff;text-align:center;padding:48px">매트릭스 로딩 실패. 잠시 후 다시 시도해 주세요.<br><br>문의: <a href="mailto:consulting@dmjgroup.kr" style="color:#FFB800;text-decoration:underline">consulting@dmjgroup.kr</a></p>';
      return;
    }
    try {
      await window.DMJMatrix.renderQuiz(
        state.level,
        state.weight,
        state.style,
        '#result-container',
        { demographic: state.demographic, sport: state.sport }
      );
      // §171 v2 — inject 2 CTA buttons + save snapshot to fmg_history.
      injectResultCTAs();
      saveFmgHistoryOnce();
    } catch (err) {
      console.error('[FindMyGear] render failed:', err);
      container.innerHTML = '<div style="color:#fff;text-align:center;padding:48px">'
        + '<p style="font-size:1.0625rem;margin:0 0 12px">결과 데이터를 불러오지 못했습니다.</p>'
        + '<p style="color:rgba(255,255,255,0.6);font-size:0.875rem;margin:0 0 24px">로컬에서 file:// 로 열고 계시다면 새로고침해 주세요.</p>'
        + '<a href="mailto:consulting@dmjgroup.kr" class="btn btn--accent">문의: consulting@dmjgroup.kr</a>'
        + '</div>';
    }
  }

  // §171 v3 (Danny 2026-05-13) — 2 CTA horizontal layout + 동일 사이즈.
  //   1) 견적서 바로 요청하기 → cart 자동 담기 + quote.html (회원 전용)
  //   2) 1:1 구매 상담하기 → consult.html (로그인 X 도 가능, 친화적 진입)
  //   layout/sizing rules → style.css `.fmg-result-cta` (DO_NOT_REVERT §171 v3).
  function injectResultCTAs() {
    const result = document.querySelector('#result-container .quiz-result');
    if (!result) return;
    // 중복 삽입 방지
    if (result.querySelector('.fmg-result-cta')) return;
    // 합계(요약) 카드 바로 아래, 기존 .quiz-result__cta 위에 삽입.
    // §172 v2 (Danny 2026-05-13): 2 button 둘 다 yellow (btn--accent). 카톡 1:1 컨설팅 row 영구 hide.
    //  - 견적서 바로 요청하기 → yellow (primary)
    //  - 1:1 구매 상담하기 → yellow (primary, 동일 가중치)
    //  - 카톡 1:1 컨설팅 (legacy .quiz-result__cta) → display:none (hidden + style hard-removed). DO_NOT_REVERT.
    const ctaRow = result.querySelector('.quiz-result__cta');
    const wrap = document.createElement('div');
    wrap.className = 'fmg-result-cta';
    wrap.innerHTML = ''
      + '<a class="btn btn--accent" id="fmg-quote-btn" href="#" style="cursor:pointer">견적서 바로 요청하기 →</a>'
      + '<a class="btn btn--accent" href="consult.html" id="fmg-consult-btn">1:1 구매 상담하기 →</a>';
    if (ctaRow) {
      result.insertBefore(wrap, ctaRow);
      ctaRow.hidden = true;
      ctaRow.style.display = 'none'; // 강제 hide — hidden 속성 CSS override 회귀 가드
    } else {
      result.appendChild(wrap);
    }

    // Wire quote button — login enforce + auto add SKUs to cart.
    const quoteBtn = document.getElementById('fmg-quote-btn');
    if (quoteBtn) {
      quoteBtn.addEventListener('click', function (e) {
        e.preventDefault();
        const loggedIn = !!(window.DMJAuth && window.DMJAuth.isLoggedIn && window.DMJAuth.isLoggedIn());
        if (!loggedIn) {
          alert('견적서 작성을 위해 로그인이 필요합니다.');
          window.location.href = 'login.html?redirect=quote.html';
          return;
        }
        if (!window.DMJCart) {
          console.warn('[FMG] DMJCart not loaded — cannot auto-fill cart.');
          window.location.href = 'quote.html';
          return;
        }
        const last = window.DMJMatrix && window.DMJMatrix._lastQuizResult;
        if (last && Array.isArray(last.recommendations)) {
          last.recommendations.forEach(function (r) {
            if (!r || !r.sku) return;
            try { window.DMJCart.add({ sku: r.sku, qty: 1, size: r.size || null, addedAt: Date.now() }); }
            catch (err) { console.warn('[FMG] cart add failed', r, err); }
          });
        }
        window.location.href = 'quote.html';
      });
    }
  }

  // §171 v2 + §169-K v3 — fmg_history save (per-user namespace).
  // 비로그인 시 dmj_anon_fmg_history (로그인 시 auth-shim 가 user namespace 로 마이그레이션).
  function saveFmgHistoryOnce() {
    if (state.savedThisSession) return;
    if (!window.DMJAuth || !window.DMJAuth.getUserData || !window.DMJAuth.setUserData) {
      console.warn('[FMG] DMJAuth not loaded — fmg_history skip.');
      return;
    }
    const last = window.DMJMatrix && window.DMJMatrix._lastQuizResult;
    if (!last) {
      console.warn('[FMG] _lastQuizResult not set — fmg_history skip.');
      return;
    }
    try {
      const entry = {
        id: 'fmg_' + Date.now().toString(36),
        savedAt: last.savedAt || Date.now(),
        date: last.date || new Date().toISOString().split('T')[0],
        level: last.level,
        weight: last.weight,
        style: last.style,
        demographic: last.demographic,
        recommendations: last.recommendations || [],
        totalKRW: last.totalKRW || 0,
        summary: last.summary || '',
        // §171-C (Danny 2026-05-13) — state-aware routing schema.
        //   'recommendation_only' (default) → 결과 페이지 복원
        //   'cart_added' → cart.html
        //   'quote_submitted' → quote.html?orderId=… 또는 profile.html#section-orders
        // DO_NOT_REVERT §171-C — schema lock. 추가 state 명시 승인 필요.
        state: 'recommendation_only',
        cartSnapshot: [],
        orderId: null
      };
      const raw = window.DMJAuth.getUserData('fmg_history') || '[]';
      let history;
      try { history = JSON.parse(raw); if (!Array.isArray(history)) history = []; }
      catch (e) { history = []; }
      history.push(entry);
      // keep last 20
      if (history.length > 20) history = history.slice(-20);
      window.DMJAuth.setUserData('fmg_history', JSON.stringify(history));
      state.savedThisSession = true;
      // §171-C — remember active entry id so subsequent cart-add / quote-submit can update its state.
      state.activeFmgEntryId = entry.id;
      try { window.DMJFmg && window.DMJFmg._setActiveEntryId && window.DMJFmg._setActiveEntryId(entry.id); } catch (e) {}
      console.info('[FMG] history saved', entry.id, entry.summary);
    } catch (err) {
      console.warn('[FMG] save failed', err);
    }
  }

  // bind option buttons
  STEPS.slice(0, TOTAL).forEach((id, i) => {
    const sec = document.getElementById(id);
    if (!sec) return;
    sec.querySelectorAll('.quiz-option').forEach(btn => {
      btn.addEventListener('click', () => {
        sec.querySelectorAll('.quiz-option').forEach(b => b.classList.remove('quiz-option--selected'));
        btn.classList.add('quiz-option--selected');
        selectOption(i, btn.dataset.value);
      });
    });
    sec.querySelectorAll('.quiz-back').forEach(btn => {
      btn.addEventListener('click', () => {
        if (i > 0) showStep(i - 1);
      });
    });
  });

  // restart
  document.getElementById('restart').addEventListener('click', () => {
    state.demographic = state.level = state.weight = state.style = state.sport = null;
    state.savedThisSession = false; // §171 v2 — allow re-save on next completion
    state.activeFmgEntryId = null;  // §171-C — disconnect from any restored entry
    document.querySelectorAll('.quiz-option--selected').forEach(b => b.classList.remove('quiz-option--selected'));
    showStep(0);
  });

  // §171-C — wire cart-add side-effect: when user clicks "+ 장바구니" on a result SKU,
  // mark the active FMG entry as 'cart_added' + record snapshot of cart at that moment.
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest ? e.target.closest('[data-cart-add]') : null;
    if (!btn) return;
    // matrix.js handles the actual add (delegated handler) — we run AFTER on next tick.
    setTimeout(function () {
      if (!state.activeFmgEntryId) return;
      if (!window.DMJCart) return;
      var snapshot = [];
      try { snapshot = window.DMJCart.getItems(); } catch (err) { snapshot = []; }
      // Only flip state if at least one item from the recommendations is actually in cart.
      // (toggle-off case: cart 비어있으면 state 회귀 X — recommendation_only 유지하려면 reset 필요하지만
      //  user 의도 = "결과 다시 보기"가 가장 자연스러우므로 latest=cart_added 유지 + snapshot=[] OK.)
      if (snapshot.length > 0) {
        updateFmgState(state.activeFmgEntryId, 'cart_added', { cartSnapshot: snapshot });
      }
    }, 50);
  });

  // §173 v9 (Danny 2026-05-16) — chat → find-my-gear deep-link.
  // 옥코치 AI 챗에서 슬롯이 다 채워진 다음 ?level=&weight=&style= 로 직행하면 퀴즈 step skip,
  // 같은 매트릭스 lookup 으로 바로 결과 노출. fmg_history 까지 동일 경로로 저장.
  // exact parity: chat-card 의 추천 = 이 deep-link 결과 = 사용자가 quiz 5-step 다 풀었을 때 결과.
  // DO_NOT_REVERT §173 v9.
  async function tryDirectFromUrlParams() {
    var params;
    try { params = new URLSearchParams(window.location.search || ''); }
    catch (e) { return false; }

    var lvl = params.get('level');
    var wt = params.get('weight');
    var sty = params.get('style');
    if (!lvl || !wt || !sty) return false;

    // Whitelist canonical values — 잘못된 값이면 자연스럽게 quiz 로 fallback.
    var validLevels = ['novice', 'beginner', 'intermediate', 'advanced', 'pro'];
    var validWeights = ['light', 'mid-light', 'mid-heavy', 'heavy'];
    var validStyles = ['flat-speed', 'choppy-freeride', 'wave', 'hybrid'];
    var validDemographics = ['adult_female', 'youth', 'senior', 'child'];
    if (validLevels.indexOf(lvl) < 0) return false;
    if (validWeights.indexOf(wt) < 0) return false;
    if (validStyles.indexOf(sty) < 0) return false;

    var demo = params.get('demographic');
    if (demo && validDemographics.indexOf(demo) < 0) demo = null;
    var sport = params.get('sport') || null;

    state.level = lvl;
    state.weight = wt;
    state.style = sty;
    state.demographic = demo || null;
    state.sport = sport;
    state.savedThisSession = false; // allow saveFmgHistoryOnce()

    showStep(TOTAL); // result step

    if (!window.DMJMatrix) {
      var c0 = document.getElementById('result-container');
      if (c0) c0.innerHTML = '<p style="color:#fff;text-align:center;padding:48px">매트릭스 로딩 실패. 잠시 후 다시 시도해 주세요.</p>';
      return true;
    }
    try {
      await window.DMJMatrix.renderQuiz(lvl, wt, sty, '#result-container',
        { demographic: demo, sport: sport });
      injectResultCTAs();
      saveFmgHistoryOnce();

      // 챗 deep-link 시 안내 banner 표시 — 사용자가 어떻게 여기 도달했는지 명시.
      if (params.get('fromchat') === '1') {
        var container = document.getElementById('result-container');
        var result = container && container.querySelector('.quiz-result');
        if (result && !result.querySelector('.fmg-fromchat-banner')) {
          var banner = document.createElement('div');
          banner.className = 'fmg-fromchat-banner';
          banner.style.cssText = 'background:rgba(255,184,0,0.12);border:1px solid rgba(255,184,0,0.4);border-radius:10px;padding:10px 14px;margin:0 0 16px;color:#fff;font-size:13px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap';
          banner.innerHTML = '<span>✨ 옥코치 AI 챗에서 받은 슬롯으로 바로 결과를 보여드려요.</span>'
            + '<a href="find-my-gear.html" style="color:var(--color-sun);font-weight:700;text-decoration:none">↻ 퀴즈 처음부터</a>';
          result.insertBefore(banner, result.firstChild);
        }
      }
      return true;
    } catch (err) {
      console.error('[FMG] direct render failed:', err);
      return false;
    }
  }

  // §171-C — initial: try restore, then try direct-from-params, else start quiz at step 0.
  (async function init() {
    var restored = false;
    try { restored = await tryRestoreFromUrlParam(); } catch (err) { restored = false; }
    if (!restored) {
      try { restored = await tryDirectFromUrlParams(); } catch (err) { restored = false; }
    }
    if (!restored) showStep(0);
  })();
})();
</script>
  <script src="assets/js/nav-auth.js" defer></script>
  <!-- §173 — 옥코치 AI Agent (전 페이지 영구 노출). DO_NOT_REVERT §173 -->
  <link rel="stylesheet" href="assets/css/agent-deny.css">
  <script src="assets/js/agent-deny.js" defer></script>
</body>
</html>
