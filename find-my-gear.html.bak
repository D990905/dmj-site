<main class="quiz-frame">

  <!-- Progress -->
  <div class="quiz-progress">
    <div class="quiz-progress__bar">
      <div class="quiz-progress__fill" id="progressBar" style="width:20%"></div>
    </div>
    <div class="quiz-progress__label">
      <span id="stepLabel">Step 1 / 5</span>
      <span>약 1분 소요</span>
    </div>
  </div>

  <!-- Step 1: Demographic (NEW v1.3) -->
  <section class="quiz-step" id="step-demographic" data-step="1">
    <div class="quiz-step__head">
      <span class="quiz-step__num">Q1 · Rider Profile</span>
      <h1 class="quiz-step__title">당신은?</h1>
      <p class="quiz-step__lead">성별·연령에 따라 윙·포일·보드 보정값이 적용됩니다</p>
    </div>
    <div class="quiz-options" role="radiogroup" aria-label="라이더 프로필 선택">
      <button class="quiz-option" data-value="adult_male">
        <h3 class="quiz-option__title">성인 남성</h3>
        <p class="quiz-option__desc">18+ · 60-90kg 표준 매트릭스 그대로</p>
      </button>
      <button class="quiz-option" data-value="adult_female">
        <h3 class="quiz-option__title">성인 여성</h3>
        <p class="quiz-option__desc">18+ · 윙 1단계 작게, 보드 볼륨 +5L 보정</p>
      </button>
      <button class="quiz-option" data-value="youth">
        <h3 class="quiz-option__title">유소년 (13-17)</h3>
        <p class="quiz-option__desc">중·고등학생, 안전 장비 필수, 작은 사이즈</p>
      </button>
      <button class="quiz-option" data-value="senior">
        <h3 class="quiz-option__title">시니어 (65세 이상)</h3>
        <p class="quiz-option__desc">안정성·관절 부담 최소화 우선</p>
      </button>
    </div>
    <div class="quiz-actions">
      <button class="quiz-back" disabled>← 이전</button>
      <span style="font-size:0.875rem;color:rgba(255,255,255,0.5)">선택 시 자동 진행</span>
    </div>
  </section>

  <!-- Step 2: Level -->
  <section class="quiz-step" id="step-level" data-step="2" style="display:none">
    <div class="quiz-step__head">
      <span class="quiz-step__num">Q2 · Skill Level</span>
      <h1 class="quiz-step__title">현재 본인 라이딩 레벨은?</h1>
      <p class="quiz-step__lead">정확한 레벨 진단이 큐레이션의 시작입니다</p>
    </div>
    <div class="quiz-options quiz-options--5col" role="radiogroup" aria-label="레벨 선택"><!-- §155 v3: 5 라이더 레벨 (입문/초급/중급/상급/선수) -->
      <button class="quiz-option" data-value="beginner">
        <h3 class="quiz-option__title">입문</h3>
        <p class="quiz-option__desc">글라이딩 단계, foiling 시도 전</p>
      </button>
      <button class="quiz-option" data-value="novice">
        <h3 class="quiz-option__title">초급</h3>
        <p class="quiz-option__desc">테이크오프 + 기본 라이딩, 택·자이빙 미완성</p>
      </button>
      <button class="quiz-option" data-value="intermediate">
        <h3 class="quiz-option__title">중급</h3>
        <p class="quiz-option__desc">원활한 foiling, 택·자이빙 부분 완성</p>
      </button>
      <button class="quiz-option" data-value="advanced">
        <h3 class="quiz-option__title">상급</h3>
        <p class="quiz-option__desc">모든 라이딩 만족 수준</p>
      </button>
      <button class="quiz-option" data-value="pro">
        <h3 class="quiz-option__title">선수</h3>
        <p class="quiz-option__desc">점핑·고속 마스터</p>
      </button>
    </div>
    <div class="quiz-actions">
      <button class="quiz-back">← 이전</button>
      <span style="font-size:0.875rem;color:rgba(255,255,255,0.5)">선택 시 자동 진행</span>
    </div>
  </section>

  <!-- Step 3: Weight -->
  <section class="quiz-step" id="step-weight" data-step="3" style="display:none">
    <div class="quiz-step__head">
      <span class="quiz-step__num">Q3 · Body Weight</span>
      <h1 class="quiz-step__title">본인 체중은?</h1>
      <p class="quiz-step__lead">체중에 따라 윙·포일·보드 size가 정확히 갈라집니다</p>
    </div>
    <div class="quiz-options" role="radiogroup" aria-label="체중 선택">
      <button class="quiz-option" data-value="light">
        <h3 class="quiz-option__title">~60kg</h3>
        <p class="quiz-option__desc">50–65kg 범위, 작은 윙·작은 보드 가능</p>
      </button>
      <button class="quiz-option" data-value="mid-light">
        <h3 class="quiz-option__title">~70kg</h3>
        <p class="quiz-option__desc">65–75kg 범위, 한국 표준 셋업</p>
      </button>
      <button class="quiz-option" data-value="mid-heavy">
        <h3 class="quiz-option__title">~80kg</h3>
        <p class="quiz-option__desc">75–85kg 범위, 큰 윙·중간 보드</p>
      </button>
      <button class="quiz-option" data-value="heavy">
        <h3 class="quiz-option__title">90kg+</h3>
        <p class="quiz-option__desc">85kg 이상, 큰 사이즈 매트릭스</p>
      </button>
    </div>
    <div class="quiz-actions">
      <button class="quiz-back">← 이전</button>
      <span style="font-size:0.875rem;color:rgba(255,255,255,0.5)">선택 시 자동 진행</span>
    </div>
  </section>

  <!-- Step 4: Style -->
  <section class="quiz-step" id="step-style" data-step="4" style="display:none">
    <div class="quiz-step__head">
      <span class="quiz-step__num">Q4 · Riding Style</span>
      <h1 class="quiz-step__title">주로 라이딩하는 컨디션은?</h1>
      <p class="quiz-step__lead">본인이 가장 자주 가는 컨디션의 특성</p>
    </div>
    <div class="quiz-options" role="radiogroup" aria-label="스타일 선택">
      <button class="quiz-option" data-value="flat-speed">
        <h3 class="quiz-option__title">Flat·Speed</h3>
        <p class="quiz-option__desc">평수면·속도, 잔잔한 컨디션</p>
      </button>
      <button class="quiz-option" data-value="choppy-freeride">
        <h3 class="quiz-option__title">Choppy·Freeride</h3>
        <p class="quiz-option__desc">한국 일반 컨디션, 표준 셋업</p>
      </button>
      <button class="quiz-option" data-value="wave">
        <h3 class="quiz-option__title">Wave</h3>
        <p class="quiz-option__desc">파도 라이딩, 파도가 좋은 컨디션</p>
      </button>
