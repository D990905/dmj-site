<!-- §169 v3 (Danny 2026-05-14) — 장비 dropdown 카테고리 진입 처리.
     ?category=foil / board / wing / safety 진입 시 카테고리 banner 표시 + quiz hint.
     quiz flow 자체는 유지 (5-step), banner 만 카테고리 명시.
     DO_NOT_REVERT §169 v3. -->
<script>
(function() {
  var params = new URLSearchParams(location.search);
  var category = params.get('category');
  if (!category) return;
  var categoryLabels = {
    'foil': { ko: '포일', desc: 'FW · Mast · Stab · 세트' },
    'board': { ko: '보드', desc: '입문 보드 · 중상급 셰이프' },
    'wing': { ko: '윙', desc: '핸들 · 붐 · FDS' },
    'safety': { ko: '안전장비', desc: '헬멧 · 임팩트 베스트 · 하니스' }
  };
  var meta = categoryLabels[category];
  if (!meta) return;
  function injectBanner() {
    if (document.querySelector('.fmg-category-banner')) return; // idempotent
    var quizSection = document.querySelector('.quiz-frame, .quiz-section, .quiz-wizard, #quiz-section, [data-quiz]');
    if (!quizSection) return;
    var banner = document.createElement('div');
    banner.className = 'fmg-category-banner';
    banner.innerHTML =
      '<span class="fmg-category-banner__label">카테고리: <strong>' + meta.ko + '</strong></span>' +
      '<span class="fmg-category-banner__desc">' + meta.desc + '</span>' +
      '<button type="button" class="fmg-category-banner__clear">전체 보기 →</button>';
    var clearBtn = banner.querySelector('.fmg-category-banner__clear');
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        location.href = location.pathname;
      });
    }
    // quiz-frame 의 첫 child 앞에 삽입 (progress bar 위)
    if (quizSection.firstElementChild) {
      quizSection.insertBefore(banner, quizSection.firstElementChild);
    } else {
      quizSection.appendChild(banner);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', injectBanner);
  } else {
    injectBanner();
  }
})();
</script>
</head>
